# App
# local: keep as "development" to allow localhost CORS
# prod: set to "production" on Render dashboard
APP_ENV=development

# CORS — allowed frontend origin
# local: http://localhost:5173 (default, no change needed)
# prod: set to your deployed Vercel URL on Render dashboard
FRONTEND_URL=http://localhost:5173

# Model
# Path to the serialized LightGBM pipeline artifact
# Default points to churn_model.pkl in the backend root — change only if you move the file
MODEL_PATH=churn_model.pkl

# Decision threshold tuned via Precision-Recall curve — Medium Risk floor
# Default: 0.5784 — only change if you retrain and re-tune the model
CHURN_THRESHOLD=0.5784

# High Risk tier floor — must be strictly greater than CHURN_THRESHOLD
# Default: 0.75 — probabilities at or above this are classified as High Risk
HIGH_RISK_THRESHOLD=0.75